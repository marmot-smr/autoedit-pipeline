# Опционально. OpenAI больше не нужен.

# Cursor Agent из скрипта/бота (локально на этом ПК):
# Ключ: https://cursor.com/dashboard/integrations
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5

# Telegram-мост (телефон → этот ПК)
# 1) @BotFather → /newbot → токен
# 2) @userinfobot → свой числовой id
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
